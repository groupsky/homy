      "pluginVersion": "9.5.21",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P3C6603E967DC8568"
          },
          "query": "SELECT last(\"m\") AS \"level\", (last(\"m\") - first(\"m\")) / 14 AS \"slope\", (last(\"m\") - 25) / (first(\"m\") - last(\"m\")) * 14 AS \"days_left\" FROM (SELECT median(\"battery\") AS \"m\" FROM \"zigbee\" WHERE time >= now() - 14d GROUP BY time(1d), \"device\") GROUP BY \"device\"",
          "rawQuery": true,
          "refId": "zigbee_percent",
          "resultFormat": "table"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P3C6603E967DC8568"
          },
          "query": "SELECT last(\"battery_low\") AS \"battery_low\" FROM \"zigbee\" WHERE time >= now() - 14d GROUP BY \"device\"",
          "rawQuery": true,
          "refId": "zigbee_low_flag",
          "resultFormat": "table"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P3C6603E967DC8568"
          },
          "query": "SELECT last(\"charge_times\") AS \"cycles\", (last(\"charge_times\") - first(\"charge_times\")) / 90 AS \"cycles_per_day\" FROM \"sunseeker_battery_info\" WHERE time >= now() - 90d GROUP BY \"service\"",
          "rawQuery": true,
          "refId": "mower",
          "resultFormat": "table"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P3C6603E967DC8568"
          },
          "query": "SELECT last(\"battery_charge\") AS \"ups_charge\", last(\"battery_runtime\") AS \"runtime\" FROM \"fleet_ups\" WHERE time >= now() - 1d GROUP BY \"ups\"",
          "rawQuery": true,
          "refId": "ups",
          "resultFormat": "table"
        }
      ],
      "title": "Batteries",
