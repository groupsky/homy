    {
      "datasource": {
        "type": "influxdb",
        "uid": "P3C6603E967DC8568"
      },
      "description": "Net energy at the PACK terminals divided by distance, over all trips longer than 5 km in the range. Net means discharge minus regen, so it is what the battery actually gave up.\n\nThis is a pack-side figure and is not comparable with a wall-to-wheel number: it excludes charger and cable losses entirely. Reference for the 7.5 weeks to 2026-09-05: about 124 Wh/km net across all trips, and 158 Wh/km measured the other way, from the BMS cumulative counters over 2863 km.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "suffix: Wh/km",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.2",
      "targets": [
        {
          "refId": "A",
          "alias": "Wh/km",
          "datasource": {
            "type": "influxdb",
            "uid": "P3C6603E967DC8568"
          },
          "query": "SELECT (sum(\"energy_net_kwh\") / sum(\"distance_km\")) * 1000 AS \"whkm\" FROM \"ioniq_sessions\"\nWHERE \"kind\"='trip' AND \"distance_km\" > 5 AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
