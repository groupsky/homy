{
  "mqtt": {
    "url": "mqtt://broker",
    "clientId": "ya-modbus-main"
  },
  "topicPrefix": "ya-modbus",
  "devices": [
    {
      "deviceId": "main",
      "driver": "@ya-modbus/driver-sdm630",
      "connection": {
        "type": "rtu",
        "port": "/dev/serial/by-path/pci-0000:00:1a.0-usb-0:1.3:1.0-port0",
        "baudRate": 9600,
        "parity": "none",
        "slaveId": 1
      },
      "polling": {
        "interval": 1000,
        "mode": "continuous"
      }
    }
  ]
}
